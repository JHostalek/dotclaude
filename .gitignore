# ===========================================
# Claude Code ~/.claude — public repo
# Ignore everything, whitelist only shareable content
# ===========================================

# Ignore everything by default
*

# --- Repo scaffolding ---
!.gitignore
!README.md
!LICENSE
!CODE_OF_CONDUCT.md
!CLAUDE.md
!SOUL.md
!CHANGELOG.md
!RELEASING.md
!package.json

# --- Release tooling ---
!scripts/
!scripts/release.mjs

# --- Rules ---
!rules/
!rules/**

# --- GitHub community health files ---
!.github/
!.github/**

# --- Claude Code plugin distribution ---
!.claude-plugin/
!.claude-plugin/**

# --- Codex plugin distribution ---
!.codex-plugin/
!.codex-plugin/**
!.agents/
!.agents/plugins/
!.agents/plugins/marketplace.json

# --- Skills (the actual value) ---
!skills/
!skills/**

# --- Exclude loose files in skills root and machine-specific skills ---
skills/*.*
skills/ccs-delegation
skills/graphify

!skills/conventional-commits.md
